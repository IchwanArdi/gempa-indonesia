generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  extensions = [postgis]
}

model Earthquake {
  id String @id @default(cuid())

  externalId String
  source     EarthquakeSource

  magnitude Float
  depthKm   Float

  latitude  Float
  longitude Float

  occurredAt DateTime

  region    String
  felt      String

  // aftershocks detection
  isAftershock Boolean  @default(false)
  mainshockId  String?
  mainshock    Earthquake?  @relation("AftershockOf", fields: [mainshockId], references: [id])
  aftershocks  Earthquake[] @relation("AftershockOf")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  geom Unsupported("geography(Point,4326)")?

  @@unique([source, externalId])
  @@index([occurredAt])
  @@index([magnitude])
  @@index([source])
  @@index([mainshockId]) 
}

enum EarthquakeSource {
  BMKG
  USGS
}
