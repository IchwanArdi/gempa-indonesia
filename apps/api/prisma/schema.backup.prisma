model Earthquake {
  id           String   @id @default(cuid())
  source       String
  externalId   String

  magnitude    Float
  depthKm      Float

  latitude     Float
  longitude    Float

  locationName String

  occurredAt   DateTime

  felt         Int?
  tsunami      Boolean?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([source, externalId])
  @@index([occurredAt])
  @@index([magnitude])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}
